# Copy to backend/.env and fill in. Real environment variables take precedence over this file.

# Option 1: connection string (account key or SAS). For local Azurite use: UseDevelopmentStorage=true
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Option 2: Microsoft Entra ID (managed identity, az login, ...). Used only when the connection string is unset.
# The identity needs the "Storage Blob Data Contributor" role on the storage account.
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

# Container holding recordings and their sidecars; created on startup if missing.
AZURE_STORAGE_CONTAINER=recordings
